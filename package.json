{
  "name": "firex-proxy",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "FireX Proxy",
  "repository": "https://github.com/Orogenesis/FireX-Proxy",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "checker:build": "cargo build --release --manifest-path native/firex-checker/Cargo.toml",
    "checker:manifest": "node scripts/sync-checker-manifest.mjs",
    "checker:release": "node scripts/release-checker.mjs",
    "checker:uninstall": "scripts/uninstall-native-host.sh",
    "checker:check-file": "cargo run --release --manifest-path native/firex-checker/Cargo.toml -- --check-file proxies.txt",
    "checker:package": "node scripts/package-native-host.mjs",
    "typecheck": "tsc --noEmit",
    "update:proxies": "node scripts/update-proxies.mjs",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "clean": "wxt clean"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.5.4",
    "wxt": "^0.20.27"
  }
}
